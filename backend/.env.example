# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Database URL (leave blank to run in-memory MongoDB in dev)
MONGODB_URI=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_development_replace_in_production
JWT_EXPIRE=30d

# Cloudinary Storage (Optional in local development; local fallback active if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client Application URL for CORS
CLIENT_URL=http://localhost:3000

# Razorpay Payment Gateway Credentials
# (Can be live or test keys; built-in sandbox simulator activates if test keys used)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
